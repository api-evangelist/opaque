        {
          "id": "0ca81dbf-77ec-49bb-af17-c82112b80257",
          "name": "Create passkey from password",
          "request": {
            "name": "Create passkey from password",
            "description": {
              "content": "Create a passkey from a password passed through the PBKDF2-SHA256 algorithm configured to use 600,011 iterations and the email as a salt. The supplied password must conform to the following guidelines:\n* The password has a minimum length of eight characters.\n* The password contains at least three of the following:\n  * A lowercase letter (a–z)\n  * An uppercase letter (A–Z)\n  * A number (0–9)\n  * A special character (@ $ ! % *  # ? &)\nNote that it is recommended to perform this encryption yourself locally; use of this endpoint is just an optional backup method.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":version",
                "auth",
                "create-passkey-from-password"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "v1.2",
                  "key": "version",
                  "description": "(Required) Version of the API to call"
                }
