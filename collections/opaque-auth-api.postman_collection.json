          "name": "Register With SSO",
          "request": {
            "name": "Register With SSO",
            "description": {
              "content": "Create a new user using an id_token and access_token gotten from auth0. Access token should be sent as a bearer token like other endpoints. Returns the users user_identity_secret.\nNote: This method will only work if the flask server is run with the OPAQUE_FF_USE_SSO_INTEGRATION feature flag set to true.",
