{
  "opencollection": "1.0.0",
  "info": {
    "name": "Opaque UI Organizations API",
    "version": "2.5"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "organizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Invite a new organization member via email",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:5001/:version/organization/invite",
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "Version of the API to call"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send email invite to a new user to join the current user's organization. Only the organization admin can call this endpoint."
        },
        {
          "info": {
            "name": "Get an invitation to organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:5001/:version/organization/invitation/:invitation-id",
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "Version of the API to call"
              },
              {
                "name": "invitation-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a specific invitation to an organization. Only the organization admin can call this endpoint."
        },
        {
          "info": {
            "name": "Get invitations to organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:5001/:version/organization/invitations",
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "Version of the API to call"
              }
            ]
          },
          "docs": "Get all the invitations to an organization. Only the organization admin can call this endpoint."
        },
        {
          "info": {
            "name": "Get organization members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:5001/:version/organization/members",
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "Version of the API to call"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the members of the organization."
        }
      ]
    }
  ],
  "bundled": true
}